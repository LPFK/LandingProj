---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Politique de confidentialité — Pazapas">
  <Nav />
  <main id="main" style="max-width:720px;margin:0 auto;padding:96px 24px;">
    <h1 style="font-family:var(--font-display);font-size:2.5rem;font-weight:600;letter-spacing:-0.02em;color:var(--color-ink);margin-bottom:48px;">
      Politique de confidentialité
    </h1>
    <p style="color:var(--color-ink-muted);line-height:1.7;margin-bottom:16px;">
      TODO_LEGAL — Ce document sera complété avant l'ouverture du service.
    </p>
    <p style="color:var(--color-ink-muted);line-height:1.7;">
      Vos données sont conservées dans l'Union européenne et ne sont jamais revendues.
      Pour toute demande, écrivez-nous à <a href="mailto:contact@pazapas.fr" style="color:var(--color-accent);">contact@pazapas.fr</a>.
    </p>
  </main>
  <Footer />
</Base>
