---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;

const title = "Mentions légales";

// TODO_LEGAL: les champs entre crochets doivent être renseignés avec l'identité
// réelle de la société avant l'ouverture du service, et l'ensemble doit être
// relu par un juriste. Voir DEPLOY_NOTES.md.
const contactEmail = "contact@exemple.fr";
const lastUpdated = "2 juillet 2026";
---

<Base title={`${title} | liste d'attente`} description="Mentions légales du service.">
  <main
    id="contenu"
    class="mx-auto max-w-[720px] px-6 py-[var(--spacing-section-mobile)] md:py-[var(--spacing-section)]"
  >
    <h1 class="text-3xl text-ink sm:text-4xl">{title}</h1>
    <p class="mt-3 text-sm text-ink-muted">Dernière mise à jour : {lastUpdated}.</p>

    <div class="mt-8 space-y-8 text-ink-muted">
      <section class="space-y-3">
        <h2 class="text-xl text-ink">Éditeur du site</h2>
        <p>
          Le présent site est édité par [Raison sociale], [forme juridique] au capital de
          [montant] euros, immatriculée au RCS de [ville] sous le numéro [SIREN], dont le siège
          social est situé [adresse complète].
        </p>
        <p>
          Numéro de TVA intracommunautaire : [numéro]. Adresse de contact : {contactEmail}.
          Téléphone : [numéro].
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl text-ink">Directeur de la publication</h2>
        <p>[Prénom et nom], en qualité de [fonction].</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl text-ink">Hébergement du site</h2>
        <p>
          Le site est hébergé par Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789,
          États-Unis. À confirmer si l'hébergeur retenu change avant la mise en ligne.
        </p>
        <p>
          Les données de la liste d'attente sont stockées séparément par Supabase, dans un
          centre de données situé dans l'Union européenne.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl text-ink">Propriété intellectuelle</h2>
        <p>
          L'ensemble des éléments du site, textes, visuels et identité graphique, est protégé au
          titre du droit d'auteur. Toute reproduction ou représentation, totale ou partielle,
          sans autorisation écrite préalable est interdite.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl text-ink">Données personnelles</h2>
        <p>
          Le traitement des données collectées via le formulaire de liste d'attente est détaillé
          dans notre
          <a class="text-accent underline" href="/politique-de-confidentialite">
            politique de confidentialité</a>.
        </p>
      </section>
    </div>

    <p class="mt-10">
      <a class="text-accent underline" href="/">Retour à l'accueil</a>
    </p>
  </main>
  <Footer />
</Base>
