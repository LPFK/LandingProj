---
import copy from "../content/copy.fr.json";
---

<header
  style="position:sticky;top:0;z-index:40;background:var(--color-bg);border-bottom:1px solid var(--color-border);transition:background 0.2s,border-color 0.2s;"
>
  <div
    style="max-width:1200px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;"
  >
    <!-- Brand → home -->
    <a
      href="/"
      class="brand-link"
      style="font-family:var(--font-display);font-size:1.25rem;font-weight:600;letter-spacing:-0.02em;color:var(--color-ink);text-decoration:none;"
    >
      {copy.nav.brand}
    </a>

    <div style="display:flex;align-items:center;gap:12px;">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="Basculer le thème clair/sombre"
        style="width:36px;height:36px;border-radius:var(--radius-pill);border:1px solid var(--color-border);background:transparent;display:flex;align-items:center;justify-content:center;color:var(--color-ink-muted);"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- CTA -->
      <a
        href="/#liste"
        class="btn-primary"
        style="font-size:0.875rem;font-weight:500;padding:10px 20px;"
      >
        {copy.nav.cta}
      </a>
    </div>
  </div>
</header>

<style>
  .icon-sun { display: none; }
  .icon-moon { display: block; }
</style>

<script>
  // Light is the default: only an explicit data-theme="dark" counts as dark.
  // This must agree with globals.css, which no longer derives the theme from
  // prefers-color-scheme. Consulting the OS here instead would show the wrong
  // icon on a dark-OS first visit, and make the first click a no-op (it would
  // compute "light", which is what the page already renders).
  function isDark(): boolean {
    return document.documentElement.getAttribute("data-theme") === "dark";
  }

  function updateIcon() {
    const sun = document.querySelector(".icon-sun") as HTMLElement | null;
    const moon = document.querySelector(".icon-moon") as HTMLElement | null;
    if (!sun || !moon) return;
    if (isDark()) {
      sun.style.display = "block";
      moon.style.display = "none";
    } else {
      sun.style.display = "none";
      moon.style.display = "block";
    }
  }

  const btn = document.getElementById("theme-toggle");
  if (btn) {
    btn.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("theme", next); } catch (_) {}
      updateIcon();
    });
  }

  // Sync icon on load
  updateIcon();
</script>
