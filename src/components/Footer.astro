---
import copy from "../content/copy.fr.json";
const { footer } = copy;
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-[var(--font-display)] text-lg text-ink">{footer.tagline}</p>
      <p class="mt-2 text-sm text-ink-muted">
        {footer.contactLabel} :
        <a class="underline hover:text-accent" href={`mailto:${footer.contactEmail}`}>
          {footer.contactEmail}
        </a>
      </p>
    </div>

    <nav aria-label="Liens légaux" class="flex flex-col gap-2 text-sm sm:text-right">
      <a class="text-ink-muted underline hover:text-accent" href="/politique-de-confidentialite">
        {footer.legal.privacy}
      </a>
      <a class="text-ink-muted underline hover:text-accent" href="/mentions-legales">
        {footer.legal.mentions}
      </a>
      <span class="text-ink-muted">© {year}. {footer.copyright}</span>
    </nav>
  </div>
</footer>
