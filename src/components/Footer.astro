---
import copy from "../content/copy.fr.json";

const year = new Date().getFullYear();
---

<footer style="background:#1A1612;color:#FAF6F1;padding:64px 24px;">
  <div
    style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:end;"
    class="footer-grid"
  >
    <div>
      <p
        style="font-family:var(--font-display);font-size:1.125rem;font-weight:600;letter-spacing:-0.02em;margin-bottom:8px;"
      >
        {copy.nav.brand}
      </p>
      <p style="font-size:0.875rem;opacity:0.5;max-width:320px;line-height:1.5;">
        {copy.footer.tagline}
      </p>
    </div>

    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:16px;" class="footer-links">
      <a
        href={`mailto:${copy.footer.contactEmail}`}
        style="font-size:0.875rem;opacity:0.65;color:inherit;text-decoration:none;transition:opacity 0.15s;"
        onmouseover="this.style.opacity='1'"
        onmouseout="this.style.opacity='0.65'"
      >
        {copy.footer.contactLabel}
      </a>
      <div style="display:flex;gap:24px;">
        <a
          href="/politique-de-confidentialite"
          style="font-size:0.8125rem;opacity:0.5;color:inherit;text-decoration:none;transition:opacity 0.15s;"
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='0.5'"
        >
          {copy.footer.legal.privacy}
        </a>
        <a
          href="/mentions-legales"
          style="font-size:0.8125rem;opacity:0.5;color:inherit;text-decoration:none;transition:opacity 0.15s;"
          onmouseover="this.style.opacity='0.85'"
          onmouseout="this.style.opacity='0.5'"
        >
          {copy.footer.legal.mentions}
        </a>
      </div>
      <p style="font-size:0.75rem;opacity:0.3;">
        &copy; {year} {copy.nav.brand}. {copy.footer.copyright}
      </p>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr !important;
    }
    .footer-links {
      align-items: flex-start !important;
    }
  }
</style>
