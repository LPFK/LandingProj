---
import copy from "../content/copy.fr.json";
---

<section style="padding:128px 24px;background:var(--color-surface);">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="margin-bottom:72px;">
      <p
        style="font-size:0.8125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent);margin-bottom:16px;"
      >
        {copy.howItWorks.eyebrow}
      </p>
      <h2
        style="font-family:var(--font-display);font-size:clamp(2rem,3.5vw,3rem);font-weight:600;letter-spacing:-0.02em;color:var(--color-ink);max-width:500px;"
      >
        {copy.howItWorks.title}
      </h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;" class="steps-grid">
      {
        copy.howItWorks.steps.map((step, i) => (
          <div
            style={`padding:48px 40px;background:var(--color-bg);${i === 0 ? "border-radius:var(--radius-card) 0 0 var(--radius-card);" : i === 2 ? "border-radius:0 var(--radius-card) var(--radius-card) 0;" : ""}`}
          >
            <span
              style="display:block;font-family:var(--font-display);font-size:3rem;font-weight:600;color:var(--color-accent-soft);letter-spacing:-0.04em;margin-bottom:24px;line-height:1;"
            >
              {step.number}
            </span>
            <h3
              style="font-family:var(--font-display);font-size:1.375rem;font-weight:600;letter-spacing:-0.02em;color:var(--color-ink);margin-bottom:12px;"
            >
              {step.title}
            </h3>
            <p style="font-size:0.9375rem;line-height:1.65;color:var(--color-ink-muted);">
              {step.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr !important;
      gap: 2px !important;
    }
    .steps-grid > div {
      border-radius: 0 !important;
    }
    .steps-grid > div:first-child {
      border-radius: var(--radius-card) var(--radius-card) 0 0 !important;
    }
    .steps-grid > div:last-child {
      border-radius: 0 0 var(--radius-card) var(--radius-card) !important;
    }
  }
</style>
