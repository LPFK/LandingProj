---
import copy from "../content/copy.fr.json";
---

<section
  style="min-height:calc(100svh - 64px);display:grid;grid-template-columns:1fr 1fr;background:var(--color-bg);"
  class="hero-grid"
>
  <!-- Copy column -->
  <div
    style="display:flex;flex-direction:column;justify-content:center;padding:80px 48px 80px 24px;max-width:640px;margin-left:auto;"
    class="hero-copy"
  >
    <p
      class="hero-anim"
      style="font-size:0.8125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent);margin-bottom:24px;"
    >
      {copy.hero.eyebrow}
    </p>

    <h1
      class="hero-anim hero-anim-d1"
      style="font-family:var(--font-display);font-size:clamp(2.75rem, 5vw, 4.5rem);font-weight:600;line-height:1.0;letter-spacing:-0.03em;color:var(--color-ink);margin-bottom:32px;"
    >
      {copy.hero.headline1}<br />
      <span style="color:var(--color-accent);">{copy.hero.headline2}</span>
    </h1>

    <p
      class="hero-anim hero-anim-d2"
      style="font-size:1.125rem;line-height:1.65;color:var(--color-ink-muted);margin-bottom:48px;max-width:480px;"
    >
      {copy.hero.subtitle}
    </p>

    <div class="hero-anim hero-anim-d3" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;">
      <a
        href="#liste"
        style="display:inline-flex;align-items:center;background:var(--color-accent);color:var(--color-ink-on-accent);font-size:1rem;font-weight:500;padding:16px 32px;border-radius:var(--radius-pill);text-decoration:none;transition:background 0.15s,transform 0.15s;box-shadow:var(--shadow-card);"
        onmouseover="this.style.background='var(--color-accent-deep)';this.style.transform='translateY(-1px)'"
        onmouseout="this.style.background='var(--color-accent)';this.style.transform='none'"
      >
        {copy.hero.cta}
      </a>

      <div class="hero-anim hero-anim-d4" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;">
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.podologist}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.noCommitment}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.eu}
        </span>
      </div>
    </div>
  </div>

  <!-- Visual column -->
  <div
    style="background:var(--color-accent-soft);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;"
    class="hero-visual hero-visual-anim"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 480 560"
      width="320"
      height="373"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <ellipse cx="240" cy="420" rx="180" ry="20" fill="rgba(184,92,42,0.12)" />
      <path
        d="M 80 380 Q 80 400 240 405 Q 400 400 400 380 L 380 340 Q 360 330 240 330 Q 120 330 100 340 Z"
        fill="var(--color-accent)"
        opacity="0.9"
      />
      <path
        d="M 100 340 Q 110 260 160 220 Q 200 190 240 188 Q 280 186 320 210 Q 370 240 380 340 Z"
        fill="#C96A38"
        opacity="0.85"
      />
      <path
        d="M 160 220 Q 200 200 240 200 Q 280 200 310 220 Q 290 210 240 212 Q 190 212 160 220 Z"
        fill="white"
        opacity="0.2"
      />
      <path
        d="M 190 250 Q 240 240 290 250 L 285 270 Q 240 260 195 270 Z"
        fill="rgba(250,246,241,0.5)"
      />
      <line x1="200" y1="255" x2="200" y2="295" stroke="rgba(250,246,241,0.6)" stroke-width="2" />
      <line x1="220" y1="250" x2="220" y2="300" stroke="rgba(250,246,241,0.6)" stroke-width="2" />
      <line x1="240" y1="248" x2="240" y2="302" stroke="rgba(250,246,241,0.6)" stroke-width="2" />
      <line x1="260" y1="250" x2="260" y2="300" stroke="rgba(250,246,241,0.6)" stroke-width="2" />
      <line x1="280" y1="255" x2="280" y2="295" stroke="rgba(250,246,241,0.6)" stroke-width="2" />
      <circle cx="360" cy="140" r="80" stroke="var(--color-accent)" stroke-width="1.5" opacity="0.3" fill="none" />
      <circle cx="360" cy="140" r="56" fill="var(--color-accent)" opacity="0.08" />
      <circle cx="120" cy="160" r="4" fill="var(--color-accent)" opacity="0.3" />
      <circle cx="134" cy="148" r="2.5" fill="var(--color-accent)" opacity="0.2" />
    </svg>
  </div>
</section>

<style>
  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }
  .trust-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
    }
    .hero-copy {
      padding: 64px 24px 48px !important;
      max-width: 100% !important;
      margin-left: 0 !important;
    }
    .hero-visual {
      min-height: 280px;
    }
  }
</style>
