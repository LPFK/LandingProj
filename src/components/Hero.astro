---
import copy from "../content/copy.fr.json";
---

<section
  style="min-height:calc(100svh - 64px);display:grid;grid-template-columns:1fr 1fr;background:var(--color-bg);"
  class="hero-grid"
>
  <!-- Copy column -->
  <div
    style="display:flex;flex-direction:column;justify-content:center;padding:80px 48px 80px 24px;max-width:640px;margin-left:auto;"
    class="hero-copy"
  >
    <p
      class="hero-anim"
      style="font-size:0.8125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent);margin-bottom:24px;"
    >
      {copy.hero.eyebrow}
    </p>

    <h1
      class="hero-anim hero-anim-d1"
      style="font-family:var(--font-display);font-size:clamp(2.75rem, 5vw, 4.5rem);font-weight:600;line-height:1.0;letter-spacing:-0.03em;color:var(--color-ink);margin-bottom:32px;"
    >
      {copy.hero.headline1}<br />
      <span style="color:var(--color-accent);">{copy.hero.headline2}</span>
    </h1>

    <p
      class="hero-anim hero-anim-d2"
      style="font-size:1.125rem;line-height:1.65;color:var(--color-ink-muted);margin-bottom:48px;max-width:480px;"
    >
      {copy.hero.subtitle}
    </p>

    <div class="hero-anim hero-anim-d3" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;">
      <a
        href="#liste"
        class="btn-primary"
        style="font-size:1rem;font-weight:500;padding:16px 32px;"
      >
        {copy.hero.cta}
      </a>

      <div class="hero-anim hero-anim-d4" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;">
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.podologist}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.noCommitment}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.eu}
        </span>
      </div>
    </div>
  </div>

  <!-- Visual column -->
  <div
    style="background:var(--color-accent-soft);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:32px;"
    class="hero-visual hero-visual-anim"
    aria-hidden="true"
  >
    <div class="hero-widget">
      <shoe-assembly src="/motion-widget/assets"></shoe-assembly>
    </div>
  </div>
</section>

<script is:inline src="/motion-widget/shoe-assembly.js"></script>

<script>
  // Subtle pointer parallax: the shoe drifts a few px toward the cursor.
  // Fine pointers only, and never when the visitor prefers reduced motion.
  (function () {
    const fine = window.matchMedia("(pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!fine || reduced) return;

    const section = document.querySelector<HTMLElement>(".hero-grid");
    const widget = document.querySelector<HTMLElement>(".hero-widget");
    if (!section || !widget) return;

    const MAX = 10; // px of drift at the edges
    let tx = 0;
    let ty = 0;
    let raf = 0;

    const apply = () => {
      raf = 0;
      widget.style.setProperty("--px", tx.toFixed(2));
      widget.style.setProperty("--py", ty.toFixed(2));
    };

    section.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        const r = section.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * MAX * 2;
        ty = ((e.clientY - r.top) / r.height - 0.5) * MAX * 2;
        if (!raf) raf = requestAnimationFrame(apply);
      },
      { passive: true },
    );

    section.addEventListener("pointerleave", () => {
      tx = 0;
      ty = 0;
      if (!raf) raf = requestAnimationFrame(apply);
    });
  })();
</script>

<style>
  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }
  .trust-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .hero-widget {
    width: 100%;
    max-width: 520px;
    /* Pointer parallax — JS feeds --px/--py, the shoe drifts a few px toward
       the cursor. Separate element from the float so the transforms compose. */
    transform: translate3d(calc(var(--px, 0) * 1px), calc(var(--py, 0) * 1px), 0);
    transition: transform var(--duration-slow) var(--ease-out);
    will-change: transform;
  }

  /* Quiet ambient buoyancy on the assembled shoe */
  .hero-widget :global(shoe-assembly) {
    display: block;
    animation: hero-float 6s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-widget {
      transform: none !important;
      transition: none !important;
    }
    .hero-widget :global(shoe-assembly) {
      animation: none !important;
    }
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
    }
    .hero-copy {
      padding: 64px 24px 48px !important;
      max-width: 100% !important;
      margin-left: 0 !important;
    }
    .hero-visual {
      min-height: 280px;
    }
  }
</style>
