---
import copy from "../content/copy.fr.json";
const { hero } = copy;
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-6 py-[var(--spacing-section-mobile)] md:grid-cols-2 md:py-[var(--spacing-section)]">
    <div class="fade-in-up">
      <p class="mb-4 inline-block rounded-pill border border-border bg-surface px-3 py-1 text-sm text-ink-muted">
        {hero.eyebrow}
      </p>
      <h1 class="text-4xl text-ink sm:text-5xl">{hero.title}</h1>
      <p class="mt-6 max-w-prose text-lg text-ink-muted">{hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#waitlist"
          class="rounded-pill bg-accent px-6 py-3 text-base font-medium text-surface shadow-soft transition-transform hover:-translate-y-0.5"
        >
          {hero.cta}
        </a>
        <span class="text-sm text-ink-muted">{hero.reassurance}</span>
      </div>
    </div>

    <div class="fade-in-up flex justify-center md:justify-end">
      <!-- Placeholder editorial visual: soft geometric SVG in accent-soft. -->
      <svg
        role="img"
        aria-label={hero.visualAlt}
        viewBox="0 0 400 400"
        class="h-auto w-full max-w-sm"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title>{hero.visualAlt}</title>
        <rect width="400" height="400" rx="24" fill="var(--color-accent-soft)" />
        <circle cx="200" cy="170" r="90" fill="var(--color-surface)" opacity="0.85" />
        <path
          d="M120 250c30-20 130-20 160 0 20 14 20 40-10 46-40 8-100 8-140 0-30-6-30-32-10-46z"
          fill="var(--color-accent)"
          opacity="0.9"
        />
        <rect x="150" y="120" width="100" height="60" rx="16" fill="var(--color-accent)" opacity="0.35" />
      </svg>
    </div>
  </div>
</section>
