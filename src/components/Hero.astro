---
import copy from "../content/copy.fr.json";
---

<section
  style="min-height:calc(100svh - 64px);display:grid;grid-template-columns:1fr 1fr;background:var(--color-bg);"
  class="hero-grid"
>
  <!-- Copy column -->
  <div
    style="display:flex;flex-direction:column;justify-content:center;padding:80px 48px 80px 24px;max-width:640px;margin-left:auto;"
    class="hero-copy"
  >
    <p
      class="hero-anim"
      style="font-size:0.8125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent);margin-bottom:24px;"
    >
      {copy.hero.eyebrow}
    </p>

    <h1
      class="hero-anim hero-anim-d1"
      style="font-family:var(--font-display);font-size:clamp(2.75rem, 5vw, 4.5rem);font-weight:600;line-height:1.0;letter-spacing:-0.03em;color:var(--color-ink);margin-bottom:32px;"
    >
      {copy.hero.headline1}<br />
      <span style="color:var(--color-accent);">{copy.hero.headline2}</span>
    </h1>

    <p
      class="hero-anim hero-anim-d2"
      style="font-size:1.125rem;line-height:1.65;color:var(--color-ink-muted);margin-bottom:48px;max-width:480px;"
    >
      {copy.hero.subtitle}
    </p>

    <div class="hero-anim hero-anim-d3" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;">
      <a
        href="#liste"
        class="btn-primary"
        style="font-size:1rem;font-weight:500;padding:16px 32px;"
      >
        {copy.hero.cta}
      </a>

      <div class="hero-anim hero-anim-d4" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;">
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.podologist}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.noCommitment}
        </span>
        <span class="trust-item">
          <span class="trust-dot"></span>
          {copy.trust.eu}
        </span>
      </div>
    </div>
  </div>

  <!-- Visual column -->
  <div
    style="background:var(--color-accent-soft);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:32px;"
    class="hero-visual hero-visual-anim"
    aria-hidden="true"
  >
    <div class="hero-widget">
      <shoe-assembly src="/motion-widget/assets"></shoe-assembly>
    </div>
  </div>
</section>

<script is:inline src="/motion-widget/shoe-assembly.js"></script>

<style>
  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }
  .trust-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .hero-widget {
    width: 100%;
    max-width: 520px;
  }
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
    }
    .hero-copy {
      padding: 64px 24px 48px !important;
      max-width: 100% !important;
      margin-left: 0 !important;
    }
    .hero-visual {
      min-height: 280px;
    }
  }
</style>
