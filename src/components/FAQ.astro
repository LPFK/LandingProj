---
import copy from "../content/copy.fr.json";
---

<section style="padding:128px 24px;background:var(--color-bg);">
  <div style="max-width:720px;margin:0 auto;">
    <p
      style="font-size:0.8125rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent);margin-bottom:16px;"
    >
      {copy.faq.eyebrow}
    </p>
    <h2
      style="font-family:var(--font-display);font-size:clamp(2rem,3vw,2.5rem);font-weight:600;letter-spacing:-0.02em;color:var(--color-ink);margin-bottom:56px;"
    >
      {copy.faq.title}
    </h2>

    <div style="display:flex;flex-direction:column;">
      {
        copy.faq.items.map((item, i) => (
          <details
            style="border-top:1px solid var(--color-border);padding:0;"
            class="faq-item"
          >
            <summary
              style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;list-style:none;gap:16px;"
            >
              <span
                style="font-size:1rem;font-weight:500;color:var(--color-ink);line-height:1.4;"
              >
                {item.q}
              </span>
              <span
                style="flex-shrink:0;width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:var(--color-accent);transition:transform 0.2s;"
                class="faq-icon"
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <div style="padding:0 0 24px;padding-right:40px;">
              <p style="font-size:0.9375rem;line-height:1.7;color:var(--color-ink-muted);">
                {item.a}
              </p>
            </div>
          </details>
        ))
      }
      <div style="border-top:1px solid var(--color-border);" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] .faq-icon { transform: rotate(180deg); }
  .faq-item summary:hover span:first-child { color: var(--color-accent); }
</style>
