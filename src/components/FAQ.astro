---
import copy from "../content/copy.fr.json";
const { faq } = copy;
---

<section id="faq" class="border-t border-border">
  <div class="mx-auto max-w-[1200px] px-6 py-[var(--spacing-section-mobile)] md:py-[var(--spacing-section)]">
    <h2 class="text-3xl text-ink sm:text-4xl">{faq.title}</h2>

    <div class="mt-10 max-w-3xl divide-y divide-border">
      {
        faq.items.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg text-ink marker:content-none">
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="text-accent transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-ink-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
