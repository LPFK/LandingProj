# Supabase (EU region). Server-only, never exposed to the client.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE="your-service-role-key"

# Resend confirmation email. Server-only.
RESEND_API_KEY="re_your_api_key"
# Verified sender identity, e.g. "Marque <bonjour@exemple.fr>".
RESEND_FROM="Marque <bonjour@exemple.fr>"

# Cloudflare Turnstile — bot protection on the waitlist API.
# Get a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Both are REQUIRED in production; leave empty locally to disable the bot check.
TURNSTILE_SECRET_KEY=""             # Server-only.
PUBLIC_TURNSTILE_SITE_KEY=""        # Exposed to the client (PUBLIC_ prefix).

# Plausible analytics domain. Exposed to the client (PUBLIC_ prefix).
# Leave empty to disable the analytics script in local development.
PUBLIC_PLAUSIBLE_DOMAIN=""
